{
  "name": "L3单用户轮次早期工具投影验收",
  "threads": [
    {
      "name": "l3-current-turn-rounds",
      "title": "L3单用户轮次早期工具投影验收-{tag}",
      "attachments": [
        {
          "file_name": "l3-rounds-{tag}.txt",
          "content": "L3-{tag}\n{payload}"
        }
      ],
      "turns": [
        {
          "name": "serial-tool-rounds",
          "query": "执行 L3-{tag} 验收。严格一次只调用一个工具，收到上一个结果后才能继续：依次使用 read_file 读取 {attachment_path} 的 offset/limit 窗口 0/100、100/100、200/100、300/100、400/100；不得并行调用。全部完成后只回答 L3-{tag}。",
          "expect": {
            "assistant_contains": ["L3-{tag}"],
            "tools_include": ["read_file"],
            "compaction": {
              "level": "L3",
              "status": "finished",
              "min_values": {
                "tool_results_projected": 1,
                "protected_messages": 1,
                "tokens_saved": 1
              }
            },
            "compaction_order": ["L1", "L2", "L3", "L5"]
          }
        }
      ]
    }
  ]
}
