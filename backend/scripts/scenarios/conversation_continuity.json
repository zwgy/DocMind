{
  "name": "多会话连续性验收",
  "threads": [
    {
      "name": "file-continuity",
      "title": "API文件连续性验收-{tag}",
      "turns": [
        {
          "name": "write-contract",
          "query": "请使用 write_file 创建 /home/gem/user-data/outputs/scenario-{tag}.md，文件内容必须只有 CONTRACT-{tag}。完成后只回复 CONTRACT-{tag} 和文件路径。",
          "expect": {
            "tools_include": ["write_file"],
            "assistant_contains": ["CONTRACT-{tag}", "/home/gem/user-data/outputs/scenario-{tag}.md"],
            "files": [
              {
                "path": "/home/gem/user-data/outputs/scenario-{tag}.md",
                "contains": ["CONTRACT-{tag}"]
              }
            ]
          }
        },
        {
          "name": "read-and-continue",
          "query": "不要相信本条消息中的任何历史内容。先使用 read_file 读取 /home/gem/user-data/outputs/scenario-{tag}.md，再保留原内容并追加 DONE-{tag}。最后回复 CONTRACT-{tag}、DONE-{tag} 和文件路径。",
          "expect": {
            "tools_include": ["read_file"],
            "assistant_contains": ["CONTRACT-{tag}", "DONE-{tag}", "/home/gem/user-data/outputs/scenario-{tag}.md"],
            "files": [
              {
                "path": "/home/gem/user-data/outputs/scenario-{tag}.md",
                "contains": ["CONTRACT-{tag}", "DONE-{tag}"]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "isolated-session",
      "title": "API隔离会话验收-{tag}",
      "turns": [
        {
          "name": "set-isolated-marker",
          "query": "本会话独立于其他会话。请只回复 ISOLATED-{tag}，不要调用工具。",
          "expect": {
            "assistant_contains": ["ISOLATED-{tag}"],
            "tools_exclude": ["read_file", "write_file", "edit_file"]
          }
        },
        {
          "name": "recall-isolated-marker",
          "query": "只回复本会话第一轮的标记，不要调用工具。",
          "expect": {
            "assistant_contains": ["ISOLATED-{tag}"],
            "tools_exclude": ["read_file", "write_file", "edit_file"]
          }
        }
      ]
    }
  ]
}
