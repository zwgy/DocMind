{
  "name": "docmind-chat-iframe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "vite serve --host",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src/ public/ test/",
    "test": "node --experimental-strip-types --import ./test/register-alias.mjs --test test/*.test.js",
    "test:p0": "node --experimental-strip-types --import ./test/register-alias.mjs --test test/chat-thread-runtime.test.js test/chat-stream-resume.test.js test/chat-active-run.test.js test/chat-history-sync.test.js test/chat-interrupt.test.js test/chat-run-status.test.js test/chat-feedback.test.js test/iframe-message.test.js test/parent-script.test.js",
    "test:reliability": "pnpm test:p0 && pnpm typecheck && pnpm lint",
    "test:p1": "pnpm test && pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.0.16",
    "vue-tsc": "^3.2.0"
  },
  "packageManager": "pnpm@10.11.0"
}
