# DocMind 生产运行模板：prod init 生成 .env.prod，已有配置保持原样。
# 只列运行项；构建设置见配置文档，不在离线目标机安装软件或构建镜像。

# 一、生产模式由生产编排固定；不能通过此项切换成开发模式。
YUXI_ENV=production

# 二、七项由初始化自动生成；数据库首次启动后不要随意替换密码。
JWT_SECRET_KEY=
YUXI_INSTANCE_ID=
SANDBOX_PROVISIONER_TOKEN=
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# 三、按浏览器实际来源填写“协议://IP或域名:端口”，多个来源用英文逗号分隔。
# 跨域来源留空：不开放跨域，正常同源访问不受影响；支持 *（不携带 Cookie）。
YUXI_CORS_ORIGINS=
# 换票来源留空：不检查请求来源；这里只支持实际地址列表，不支持 * 通配符。
CHAT_IFRAME_ALLOWED_ORIGINS=
# CHAT_IFRAME_TOKEN_RATE_LIMIT_PER_MINUTE=60

# 四、模型地址、模型 ID、嵌入维度和默认模型：启动后在系统设置的模型配置页填写。
# 凭据可以直接在网页填写；如供应商指定环境变量凭据，按实际名称取消注释并填写。
# INTRANET_MODEL_API_KEY=
# 内置 OCR：在系统设置的文档解析配置中选择 RapidOCR (ONNX)，高级参数保留 {}。

# 五、可选运行调节：包内数据库地址和沙盒连接已经配好，通常无需修改。
# SANDBOX_EXEC_TIMEOUT_SECONDS=180
# SANDBOX_MAX_OUTPUT_BYTES=262144
# SANDBOX_KEEPALIVE_INTERVAL_SECONDS=30
# SANDBOX_IDLE_TIMEOUT_SECONDS=120
# SANDBOX_IDLE_CHECK_INTERVAL_SECONDS=10
# 沙盒代理按现场需要填写，不复制开发机代理。
# SANDBOX_HTTP_PROXY=
# SANDBOX_HTTPS_PROXY=
# URL 文档解析域名/IP列表，留空表示不启用 URL 解析。
# YUXI_URL_WHITELIST=
