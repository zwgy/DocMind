# ============================================================
#  DocMind 配置蓝本 —— init 脚本基于本文件生成 .env
#  维护规则（按 region 区分询问策略）：
#    - 必填且脚本无法生成 → init 会询问用户（required）
#    - 必填且脚本能生成   → init 会自动生成（auto-generated）
#    - 可选项             → init 不询问，用户按需取消注释
#    - 基础设施默认值     → 直接生效，用户一般无需改
#  新增变量时请按上面的规则分类，并在 init.sh / init.ps1 中
#  添加一行 ask_or_skip / Update-EnvVar 调用。
# ============================================================

# region model_provider
SILICONFLOW_API_KEY=  # 推荐使用硅基流动免费服务 https://cloud.siliconflow.cn/i/Eo5yTHGJ
TAVILY_API_KEY=  # 获取搜索服务的 api key 请访问 https://app.tavily.com/

# JWT 安全配置：首次部署请生成随机值，初始化脚本会在留空时自动生成
YUXI_ENV=development
JWT_SECRET_KEY=
YUXI_INSTANCE_ID=
# 沙箱管理接口认证：首次部署由初始化脚本生成至少 32 字符的随机值
SANDBOX_PROVISIONER_TOKEN=

# 生产基础设施凭据：开发环境留空时使用 Compose 默认值，生产环境必须显式填写
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# CORS allowed origins for browser clients, comma-separated.
# Development defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
# Production does not allow cross-origin browser requests unless this is explicitly set.
YUXI_CORS_ORIGINS=

# chat-iframe 默认使用父页面传入的外部用户身份自助换取 DocMind token。
# 可选：允许自助换票的父页面 Origin，逗号分隔；留空表示不按 Origin 校验。
CHAT_IFRAME_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# 可选：/api/chat-iframe/token 每分钟每 IP 限流次数；设为 0 可关闭该接口限流。
CHAT_IFRAME_TOKEN_RATE_LIMIT_PER_MINUTE=60

# AI 文档智能助手来文接入（可选）：来文默认只做保存、解析和摘要，不自动写入知识库
# BUSINESS_EXTRACTION_MODEL=

# # 其余可选配置
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# ZHIPUAI_API_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# ARK_API_KEY=
# MINIMAX_API_KEY=  # MiniMax 大模型 https://platform.minimaxi.com/
# TOGETHER_API_KEY=
# # endregion model_provider

# # region neo4j
# NEO4J_URI=
# NEO4J_USERNAME=
# # endregion neo4j

# # Servies
# YUXI_SUPER_ADMIN_NAME=
# YUXI_SUPER_ADMIN_PASSWORD=

# # URL Whitelist (comma-separated domains/IPs, empty to disable URL parsing)
# YUXI_URL_WHITELIST=github.com,docs.example.com,gitlab.example.com,127.0.0.1

# # MinerU
# MINERU_API_KEY=

# Sandbox (deerFlow-style provisioner)
# SANDBOX_PROVIDER=provisioner
# SANDBOX_PROVISIONER_URL=http://sandbox-provisioner:8002
# SANDBOX_VIRTUAL_PATH_PREFIX=/home/gem/user-data
# SANDBOX_EXEC_TIMEOUT_SECONDS=180
# SANDBOX_MAX_OUTPUT_BYTES=262144
# SANDBOX_KEEPALIVE_INTERVAL_SECONDS=30
# SANDBOX_IDLE_TIMEOUT_SECONDS=120
# SANDBOX_IDLE_CHECK_INTERVAL_SECONDS=10
# # sandbox-provisioner backend: memory | docker | kubernetes
# SANDBOX_PROVISIONER_BACKEND=docker

# sandbox-provisioner 通用配置
# SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
# SANDBOX_CONTAINER_PORT=8080
# SANDBOX_HEALTH_TIMEOUT_SECONDS=300
# MEMORY_SANDBOX_URL_TEMPLATE=http://agent-sandbox:8000
# SANDBOX_HTTP_PROXY=http://host.docker.internal:7897
# SANDBOX_HTTPS_PROXY=http://host.docker.internal:7897

# Docker backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=docker)
# 应用网络与动态沙箱网络必须分离，不能配置成同一个名称
# APP_DOCKER_NETWORK=yuxi-know_app-network
# SANDBOX_DOCKER_NETWORK_PREFIX=yuxi-know-sandbox
# SANDBOX_DOCKER_THREADS_HOST_PATH=
# SANDBOX_DOCKER_SANDBOX_PREFIX=yuxi-sandbox

# Kubernetes backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=kubernetes)
# SANDBOX_K8S_NAMESPACE=yuxi-know
# SANDBOX_NODE_HOST=host.docker.internal
# KUBECONFIG_PATH=/root/.kube/config
# THREAD_PVC=yuxi-thread
# SKILLS_PVC=yuxi-skills  # 当前代码会读取，但 Pod 挂载实际仍只使用 THREAD_PVC

# === 宿主机端口（部署时按本机环境调整，避免与其他服务冲突） ===
# 留空 = 用默认值；改这里一处，所有相关组件（容器映射、浏览器链接、API 预签 URL）自动跟随。
# 与同一台机器上其他项目（smart_ticket 等）冲突时，按需把任一项改为空闲端口。
# 默认仅允许宿主机访问基础设施；确需其他机器直连时显式改为 0.0.0.0。
INFRA_BIND_HOST=127.0.0.1
CHAT_IFRAME_DEV_HOST_PORT=5174
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
MILVUS_GRPC_HOST_PORT=19532
MILVUS_HEALTH_HOST_PORT=9092

# === 浏览器访问外部地址（前端打开 MinIO / Milvus 控制台用） ===
# 默认值与上方宿主机端口一致；如改了宿主机端口，这里要同步改（或保持默认留空，前端兜底用默认端口）。
VITE_MINIO_CONSOLE_URL=http://localhost:9011
VITE_MILVUS_WEBUI_URL=http://localhost:9092/webui/

# === Docker 构建镜像源（可选） ===
# API 镜像默认使用清华 Debian 源加速 apt 安装；如果本机 Docker 无法访问该源，可改为 deb.debian.org。
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
APT_SECURITY_MIRROR=mirrors.tuna.tsinghua.edu.cn/debian-security
# 前端基础镜像默认直连 Docker Hub。不同网络环境请在各自的 .env/.env.prod 中取消注释并改为可访问的镜像仓库；这些文件不会提交到 Git。
# NODE_ALPINE_IMAGE=node:24-alpine
# NGINX_ALPINE_IMAGE=nginx:alpine

# MinerU；使用 GPUStack 时将 backend 设为 vlm-http-client，服务地址不要带 /v1
MINERU_API_URI=http://mineru-api:30001
MINERU_BACKEND=hybrid-engine
# MinerU 独立部署使用的 GPU 编号和 vLLM 显存占比；与其他任务共享 GPU 时继续下调占比
MINERU_GPU_DEVICE_ID=0
MINERU_GPU_MEMORY_UTILIZATION=0.7
