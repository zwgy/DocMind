# DocMind 开发及联网构建配置模板：scripts/init.sh 或 init.ps1 生成 .env。
# 生产初始化使用 .env.prod.template；已有配置和密钥不会被初始化脚本覆盖。

# 一、开发运行必需项：三个空值由初始化脚本自动生成。
YUXI_ENV=development
JWT_SECRET_KEY=
YUXI_INSTANCE_ID=
SANDBOX_PROVISIONER_TOKEN=

# 二、网页来源：留空时开发跨域使用 localhost:5173；换票来源仅接受列表，不支持 *。
# YUXI_CORS_ORIGINS 支持 *；CHAT_IFRAME_ALLOWED_ORIGINS 留空表示不限制换票来源。
YUXI_CORS_ORIGINS=
CHAT_IFRAME_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# CHAT_IFRAME_TOKEN_RATE_LIMIT_PER_MINUTE=60

# 三、开发端口：保留项目现有端口，防止与同机其他项目冲突。
# 基础设施默认仅宿主机可访问；确需其他电脑直连时再修改绑定地址。
INFRA_BIND_HOST=127.0.0.1
CHAT_IFRAME_DEV_HOST_PORT=5174
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
MILVUS_GRPC_HOST_PORT=19532
MILVUS_HEALTH_HOST_PORT=9092

# 四、模型及可选工具：均不是启动必填，地址、模型和默认模型在网页配置。
# 使用供应商的环境变量凭据时再填写；自建模型可以采用自定义变量名。
# SILICONFLOW_API_KEY=
# OPENAI_API_KEY=
# INTRANET_MODEL_API_KEY=
# TAVILY_API_KEY=
# URL 文档解析的域名/IP列表；不配置则关闭 URL 解析。
# YUXI_URL_WHITELIST=docs.example.com,10.0.0.10

# 五、数据库高级覆盖：开发使用 Compose 默认值，生产由专用初始化生成密码。
# POSTGRES_PASSWORD=
# NEO4J_PASSWORD=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# NEO4J_URI=bolt://graph:7687
# NEO4J_USERNAME=neo4j

# 六、沙盒：默认使用 Docker 管理服务；只在需要改变对应设置时取消注释。
# SANDBOX_EXEC_TIMEOUT_SECONDS=180
# SANDBOX_MAX_OUTPUT_BYTES=262144
# SANDBOX_KEEPALIVE_INTERVAL_SECONDS=30
# SANDBOX_IDLE_TIMEOUT_SECONDS=120
# SANDBOX_IDLE_CHECK_INTERVAL_SECONDS=10
# SANDBOX_HTTP_PROXY=
# SANDBOX_HTTPS_PROXY=
# 联网编排的命名覆盖；离线包会按实例名自动生成，不读取这两个前缀。
# APP_DOCKER_NETWORK=yuxi-know_app-network
# SANDBOX_DOCKER_NETWORK_PREFIX=yuxi-know-sandbox
# SANDBOX_DOCKER_SANDBOX_PREFIX=yuxi-sandbox
# SANDBOX_DOCKER_THREADS_HOST_PATH=

# 七、联网构建：不会在离线安装时下载软件或重新构建网页。
# 两个网页控制台地址在构建时写入，必须与开发端口对应，运行时修改不生效。
VITE_MINIO_CONSOLE_URL=http://localhost:9011
VITE_MILVUS_WEBUI_URL=http://localhost:9092/webui/
# 普通系统软件源与安全更新源；不配置则使用 Dockerfile 默认值。
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# APT_SECURITY_MIRROR=mirrors.tuna.tsinghua.edu.cn/debian-security
# NODE_ALPINE_IMAGE=node:24-alpine
# NGINX_ALPINE_IMAGE=nginx:alpine

# 八、可选外部解析：内置 RapidOCR 不需要这些参数；默认 OCR 在网页设置。
# 仅选择 MinerU HTTP API 时需要；独立 GPU 服务见 docker/mineru/README.md。
# MINERU_API_URI=http://mineru-api:30001
# MINERU_BACKEND=hybrid-engine
# 仅使用 MinerU 官方云 API 时填写。
# MINERU_API_KEY=
