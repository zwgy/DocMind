# 强制文本文件以 LF 换行符参与版本控制，
# 避免 Windows 编辑器保存时引入 CRLF 导致 Linux 脚本运行失败。
# 详见 https://docs.github.com/en/get-started/getting-started-with-git/configuring-git-to-handle-line-endings

# Shell 脚本：必须在 Linux 上以 LF 执行
*.sh                text eol=lf
*.bash              text eol=lf

# PowerShell 脚本：LF 即可，PowerShell 同时支持 LF/CRLF
*.ps1               text eol=lf

# 容器与基础设施
Dockerfile*         text eol=lf
*.dockerfile        text eol=lf
docker-compose*.yml text eol=lf
docker-compose*.yaml text eol=lf

# 后端 / 前端源码
*.py                text eol=lf
*.js                text eol=lf
*.mjs               text eol=lf
*.cjs               text eol=lf
*.ts                text eol=lf
*.tsx               text eol=lf
*.jsx               text eol=lf
*.vue               text eol=lf
*.json              text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.toml              text eol=lf
*.md                text eol=lf
*.css               text eol=lf
*.less              text eol=lf
*.html              text eol=lf

# 显式声明二进制文件（防止被 Git 误判为文本而触发合并时的 CRLF 转换）
*.png               binary
*.jpg               binary
*.jpeg              binary
*.gif               binary
*.ico               binary
*.pdf               binary
*.zip               binary
*.tar               binary
*.gz                binary
*.whl               binary
